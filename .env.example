# Скопируйте в .env: cp .env.example .env. Ключ LLM не обязателен — при DEMO_MODE=true всё работает без него.
APP_NAME=hackalem-app
APP_ENV=dev

# Any OpenAI-compatible provider
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# NVIDIA NIM alternative:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct
# Своя модель в vLLM (см. README, раздел про LLM):
# LLM_BASE_URL=http://<сервер>:8000/v1
# LLM_MODEL=qwen2.5-14b-instruct
# Защита чата от зависания: таймаут одного вызова модели и лимит длины ответа
# LLM_TIMEOUT_S=60
# LLM_MAX_TOKENS=1200

# Embeddings for document search (defaults to LLM provider)
EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=

# true: ассистент по шаблонам без LLM (расчёт работает всегда). false: нужен LLM_API_KEY
DEMO_MODE=true

DATA_DIR=data/sample
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host ports for docker compose (change if busy)
API_PORT=8000
WEB_PORT=8080

# Login (demo users). Format login:password:role:Display name, roles: manager | admin
AUTH_ENABLED=true
AUTH_USERS=manager:demo:manager:Менеджер отдела закупа,admin:admin:admin:Администратор
# AUTH_SECRET=change-me

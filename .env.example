# Copy to .env and fill in. Reviewers: a demo key is provided in the submission form.
APP_NAME=hackalem-app
APP_ENV=dev

# Any OpenAI-compatible provider
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# NVIDIA NIM alternative:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Embeddings for document search (defaults to LLM provider)
EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=

# Set to true to run the main scenario without any API key
DEMO_MODE=false

DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host ports for docker compose (change if busy)
API_PORT=8000
WEB_PORT=8080
